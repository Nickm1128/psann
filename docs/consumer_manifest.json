  "inputs": [
    {
      "path": "datasets/wave_resnet_small.npz",
      "kind": "tracked",
      "consumer": "configs/hisso"
    },
    {
      "path": "examples/lm/sample_texts.txt",
      "kind": "tracked",
      "consumer": "lm-task"
    },
    {
      "path": "examples/lm/tokenizer/sample_texts.model",
      "kind": "tracked",
      "consumer": "tokenizer"
    },
    {
      "path": "examples/lm/tokenizer/sample_texts.vocab",
      "kind": "tracked",
      "consumer": "tokenizer"
    },
    {
      "path": "datasets/lm/tiny_books.txt",
      "kind": "generated",
      "generator": "scripts/make_tiny_corpus.py",
      "arguments": [
        "--out",
        "datasets/lm/tiny_books.txt",
        "--mb",
        "1"
      ],
      "consumer": "examples/lm/configs/tiny_corpus_benchmark.yaml"
    },
    {
      "path": "benchmarks/hisso_portfolio_prices.csv",
      "kind": "tracked",
      "consumer": "hisso-benchmark"
    },
    {
      "kind": "external",
      "provider": "Hugging Face datasets/tokenizers",
      "consumer": "lm-benchmark",
      "description": "Dataset/revision/split/tokenizer settings come from each configuration; local smoke coverage substitutes a declared synthetic corpus."
    },
    {
      "kind": "external",
      "provider": "yfinance",
      "consumer": "notebooks/bitcoin_5m_lsm_mixed_geosparse_direction.ipynb",
      "description": "Public provider data with changing five-minute retention; network/full experiment is opt-in."
    }
  ],
  "workflows": [
    {
      "name": "core",
      "consumer": "examples/quickstarts.py",
      "function": "core",
      "preprocessing": false
    },
    {
      "name": "preprocessing",
      "consumer": "examples/quickstarts.py",
      "function": "core",
      "preprocessing": true
    },
    {
      "name": "episodic",
      "consumer": "examples/quickstarts.py",
      "function": "episodic",
      "preprocessing": false
    },
    {
      "name": "lm",
